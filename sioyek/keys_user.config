# Zathura/Vim-style navigation
move_right h
move_down j
move_up k
move_left l

# Half-screen and full-page movement
screen_down <C-d>
screen_up <C-u>
next_page J
previous_page K

# Document navigation
goto_beginning gg
goto_end G

# Search
search /
next_item n
previous_item N

# Zoom and page fitting
zoom_in +
zoom_out -
fit_to_page_width s
fit_to_page_height a

# Links and application commands
open_link f
reload r
quit q
