on_force_close "detach"

scroll_buffer_size 10000
mouse_mode true

keybinds {
    locked {
        bind "Ctrl q" { SwitchToMode "Normal"; }

        // Keep split navigation inside Neovim while Zellij is locked.
        // Ctrl-w + direction uses Neovim's native window navigation, bypassing
        // smart-splits' Zellij integration at the outer window edge.
        bind "Ctrl h" { Write 23 104; }
        bind "Ctrl j" { Write 23 106; }
        bind "Ctrl k" { Write 23 107; }
        bind "Ctrl l" { Write 23 108; }
    }
    shared_except "locked" {
        bind "Ctrl q" { SwitchToMode "Locked"; }
        bind "Ctrl a" { SwitchToMode "Tmux"; }

        // focus
        bind "Ctrl Left" { MoveFocus "Left"; }
        bind "Ctrl Right" { MoveFocus "Right"; }
        bind "Ctrl Down" { MoveFocus "Down"; }
        bind "Ctrl Up" { MoveFocus "Up"; }
        bind "Ctrl h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "left"
            }
        }
        bind "Ctrl j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "down"
            }
        }
        bind "Ctrl k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "up"
            }
        }
        bind "Ctrl l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "right"
            }
        }

        // move
        bind "Alt Left" { MovePane "Left"; }
        bind "Alt Right" { MovePane "Right"; }
        bind "Alt Down" { MovePane "Down"; }
        bind "Alt Up" { MovePane "Up"; }
        bind "Alt h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "resize"
                payload "left"
            }
        }
        bind "Alt j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "resize"
                payload "down"
            }
        }
        bind "Alt k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "resize"
                payload "up"
            }
        }
        bind "Alt l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "resize"
                payload "right"
            }
        }
        bind "Alt ]" { GoToNextTab; }
        bind "Alt [" { GoToPreviousTab; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Alt f" { TogglePaneEmbedOrFloating; }
        bind "Alt t" { NextSwapLayout; }
    }
    tmux {
        // clear
        bind "l" { Clear; SwitchToMode "Normal"; }
    }
    unbind "Ctrl g" // used by claude code/codex to enter editor
}

pane_frames false
