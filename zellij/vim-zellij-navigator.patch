+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    // Zellij supplies this import in WASM. Native tests only inspect routing
+    // state and must never invoke the host API.
+    #[cfg(not(target_family = "wasm"))]
+    #[no_mangle]
+    pub extern "C" fn host_run_plugin_command() {
+        panic!("unexpected Zellij host API call in a native test");
+    }
+
+    fn focused_client(pane_id: u32, command: &str) -> ClientInfo {
+        ClientInfo {
+            client_id: 1,
+            pane_id: PaneId::Terminal(pane_id),
+            running_command: command.to_string(),
+            is_current_client: true,
+        }
+    }
+
+    #[test]
+    fn pending_key_retains_detected_vim_pane_when_focus_changes() {
+        let mut state = State::default();
+        state.current_client = Some(focused_client(7, "/usr/bin/nvim file.txt"));
+        let pending_target = state.current_vim_pane_id().unwrap();
+
+        // A subsequent client snapshot sees the shell after Neovim moves focus.
+        state.current_client = Some(focused_client(9, "zsh"));
+        assert_eq!(pending_target, PaneId::Terminal(7));
+        assert_eq!(state.current_vim_pane_id(), None);
+    }
+
+    #[test]
+    fn vim_detection_preserves_the_pane_id() {
+        for command in ["nvim", "vim", "/usr/bin/vim file.txt"] {
+            let mut state = State::default();
+            state.current_client = Some(focused_client(42, command));
+            assert_eq!(state.current_vim_pane_id(), Some(PaneId::Terminal(42)));
+        }
+    }
+
+    #[test]
+    fn missing_client_or_non_vim_command_never_receives_injected_keys() {
+        let mut state = State::default();
+        assert_eq!(state.current_vim_pane_id(), None);
+        for command in ["zsh", "bash", "N/A", "", "nvim-other"] {
+            state.current_client = Some(focused_client(9, command));
+            assert_eq!(state.current_vim_pane_id(), None);
+        }
+    }
+}
